-- 7.1 Replication slots
\echo '-- 7.1 Replication slots'
-- 7.1 Replication slots
SELECT 
    slot_name,
    slot_type,
    database,
    active,
    xmin,
    catalog_xmin,
    restart_lsn,
    confirmed_flush_lsn,
    pg_size_pretty(pg_wal_lsn_diff(pg_current_wal_lsn(), restart_lsn)) AS lag_size,
    CASE 
        WHEN NOT active THEN '🔴 INACTIVE - may block WAL recycling'
        WHEN pg_wal_lsn_diff(pg_current_wal_lsn(), restart_lsn) > 1073741824 THEN '🟠 Large lag (>1GB)'
        ELSE '🟢 OK'
    END AS status
FROM pg_replication_slots;
 slot_name | slot_type | database | active | xmin | catalog_xmin | restart_lsn | confirmed_flush_lsn | lag_size | status 
