PART 8: MEMORY OPTIMIZATION - MEMORY ANALYSIS
============================================================================

----------------------------------------------------------------------------
8.1. Shared buffers usage (requires pg_buffercache extension)
CREATE EXTENSION IF NOT EXISTS pg_buffercache;
psql:performance_test.sql:901: ERROR:  permission denied to create extension "pg_buffercache"
HINT:  Must be rds_superuser to create this extension.
----------------------------------------------------------------------------
SELECT
    c.relname,
    count(*) AS buffers,
    pg_size_pretty(count(*) * 8192) AS size_in_cache
FROM pg_buffercache b
INNER JOIN pg_class c ON b.relfilenode = pg_relation_filenode(c.oid)
    AND b.reldatabase IN (0, (SELECT oid FROM pg_database WHERE datname = current_database()))
WHERE c.relnamespace = (SELECT oid FROM pg_namespace WHERE nspname = 'public')
GROUP BY c.relname
ORDER BY count(*) DESC
LIMIT 20;
