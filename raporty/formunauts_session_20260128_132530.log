----------------------------------------------------------------------------
10.8. Autovacuum activity monitoring
----------------------------------------------------------------------------
SELECT
    datname,
    usename,
    pid,
    backend_start,
    query_start,
    EXTRACT(EPOCH FROM (now() - query_start)) AS duration_sec,
    state,
    wait_event_type,
    wait_event,
    LEFT(query, 200) AS query
FROM pg_stat_activity
WHERE query LIKE '%autovacuum%'
    AND query NOT LIKE '%pg_stat_activity%'
ORDER BY query_start;
 datname | usename | pid | backend_start | query_start | duration_sec | state | wait_event_type | wait_event | query 
