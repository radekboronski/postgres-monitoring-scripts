============================================================================
PART 2: SQL QUERY OPTIMIZATION - ANALYSIS AND OPTIMIZATION
============================================================================

----------------------------------------------------------------------------
2.1. TOP 20 slowest queries (by average execution time)
----------------------------------------------------------------------------
/* Uncomment to reset statistics:
SELECT pg_stat_statements_reset();
SELECT pg_stat_reset();
*/



SELECT 
    queryid,
    LEFT(query, 100) AS query_preview,
    calls,
    ROUND(total_exec_time::numeric, 2) AS total_time_ms,
    ROUND(mean_exec_time::numeric, 2) AS avg_time_ms,
    ROUND(min_exec_time::numeric, 2) AS min_time_ms,
    ROUND(max_exec_time::numeric, 2) AS max_time_ms,
    ROUND(stddev_exec_time::numeric, 2) AS stddev_time_ms,
    rows,
    ROUND((100.0 * shared_blks_hit / NULLIF(shared_blks_hit + shared_blks_read, 0))::numeric, 2) AS cache_hit_ratio,
    shared_blks_read,
    shared_blks_hit,
    shared_blks_dirtied,
    shared_blks_written,
    temp_blks_read,
    temp_blks_written
FROM pg_stat_statements
WHERE query NOT LIKE '%pg_stat_statements%'
    AND query NOT LIKE 'DEALLOCATE%'
ORDER BY mean_exec_time DESC
LIMIT 20;
