PART 5: LOCKS AND BLOCKING
============================================================================
----------------------------------------------------------------------------
5.1. Current locks
----------------------------------------------------------------------------
SELECT
    l.pid,
    l.locktype,
    l.mode,
    l.granted,
    l.relation::regclass AS relation,
    a.usename,
    a.state,
    LEFT(a.query, 100) AS query
FROM pg_locks l
JOIN pg_stat_activity a ON l.pid = a.pid
WHERE l.relation IS NOT NULL
    AND a.pid != pg_backend_pid()
ORDER BY l.granted, l.pid;
